{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // NOTE: matchPackagePatterns was REMOVED in Renovate v40 (we run 44.x). It is
  // not migrated — Renovate logs "No config migration necessary" and simply
  // ignores the key. A rule whose only matcher is unrecognised has no
  // constraints, so it matched EVERY package; last-wins precedence then let the
  // permissive rules override "critical infrastructure", and rook-ceph /
  // cert-manager PRs came out as "Automerge: Enabled".
  //
  // All matchers below use matchPackageNames. A value wrapped in /.../ is a
  // regex (unanchored unless you anchor it); anything else is an exact name.
  //
  // Policy (2026-10-22): with Rook, OpenEBS and authentik's Postgres gone, most
  // of the cluster is stateless or restores from R2, and HelmReleases roll back
  // a failed upgrade. So minor, patch and digest updates automerge everywhere
  // once "Validate Success" passes; majors still wait for approval
  // (upgradePolicy.json5 keeps Postgres majors off entirely). Only components
  // whose upgrade can't roll back stay manual (see the last rule).
  //
  // Ordering matters: rules apply in order and later rules win. The
  // critical-infrastructure rule is deliberately LAST so nothing can re-enable
  // automerge for it. That matters because ghcr.io/home-operations/ holds both
  // media apps (sonarr, plex, ...) and infra chart mirrors
  // (charts-mirror/cilium).

  // Security fixes - expedited. This replaces a packageRule that used
  // "matchVulnerabilityAlerts", which isn't a Renovate option: like
  // matchPackagePatterns above it was ignored, so the rule matched every
  // package and turned automerge on for all of them.
  "vulnerabilityAlerts": {
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": true
  },

  "packageRules": [
    // Default: minor, patch and digest updates automerge. "pr" with platform
    // automerge, not "branch": Validate only runs on pull requests, so a branch
    // automerge would have no checks to wait for.
    {
      "description": "Auto merge minor, patch and digest updates by default",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false
    },

    // GitHub Actions - Always automerge
    {
      "description": "Auto merge Github Actions",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": false,
      "matchUpdateTypes": ["major", "minor", "patch"]
    },

    // Terraform - Always automerge
    {
      "description": "Auto merge Terraform providers and modules",
      "matchManagers": ["terraform"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": false,
      "matchUpdateTypes": ["major", "minor", "patch"]
    },

    // Major updates need approval
    {
      "description": "Major updates require manual approval",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },

    // Critical Infrastructure - No automerge.
    // LAST on purpose: this must override every rule above it.
    // Only what can't roll itself back:
    //   cilium        disableWait: true, so Helm reports success at once and
    //                 never rolls back; a bad datapath also cuts Flux off, and
    //                 the fix is helmfile from a laptop.
    //   flux2         helm-controller performs rollbacks, so a crashlooping
    //                 new controller can't undo itself.
    // external-secrets, 1Password Connect, flux-operator, cert-manager and
    // external-dns roll back (strategy: rollback) and fail soft (existing
    // Secrets, certs and DNS records stay), so they automerge.
    {
      "description": "Critical infrastructure - manual approval required",
      "matchPackageNames": [
        // the Flux chart mirror and the bootstrap helmfile's cilium/cilium
        "/(^|/)cilium$/",
        "/flux-instance$/",
        "/^fluxcd/flux2$/",
      ],
      "automerge": false
    }
  ]
}
