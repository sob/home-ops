---
machine:
  nodeLabels:
    topology.kubernetes.io/zone: basement
    # Has eno1.99 (LAN-IOT) for Multus macvlan attachments (kube-system/multus).
    network.56kbps.io/iot-vlan: "true"
  type: controlplane
  network:
    hostname: metal-03
    interfaces:
      - deviceSelector:
          hardwareAddr: 94:c6:91:a4:0a:61
        addresses:
          - 10.1.100.103/24
        routes:
          - network: 0.0.0.0/0
            gateway: 10.1.100.1
        dhcp: false
        vip:
          ip: 10.1.100.100
        # LAN-IOT, tagged on the switch port (LAN-METAL is native). No address:
        # the node stays off LAN-IOT; only Multus macvlan pods get one.
        vlans:
          - vlanId: 99
            dhcp: false
  install:
    diskSelector:
      model: 'Micron_1100_MTFD*'
