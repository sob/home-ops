---
machine:
  nodeLabels:
    # Garage rack / failure domain (existing rack = zone "basement")
    topology.kubernetes.io/zone: garage
    # Has eno1.99 (LAN-IOT) for Multus macvlan attachments (kube-system/multus).
    # The prefix is the cluster domain, which `op inject` fills in at render time.
    network.{% raw %}{{ op://STONEHEDGES/cluster-secrets/SECRET_INTERNAL_DOMAIN }}{% endraw %}/iot-vlan: "true"
  type: worker
  network:
    hostname: metal-11
    interfaces:
      # Confirmed MAC for metal-11 (the 1c:69:7a box).
      - deviceSelector:
          hardwareAddr: 1c:69:7a:63:d6:4a
          # VLAN links share the parent's MAC; without this they match too.
          physical: true
        addresses:
          - 10.1.100.111/24
        routes:
          - network: 0.0.0.0/0
            gateway: 10.1.100.1
        dhcp: false
        # No address: the node stays off LAN-IOT; only macvlan pods get one.
        vlans:
          - vlanId: 99
            dhcp: false
  install:
    # Boot disk only. The Ceph OSD disk (separate device) is declared in the
    # Rook CephCluster `storage.nodes` list, not here.
    diskSelector:
      serial: '211803A001B3'
