---
machine:
  nodeLabels:
    topology.kubernetes.io/zone: basement
  type: controlplane
  network:
    hostname: metal-02
    interfaces:
      - deviceSelector:
          hardwareAddr: 94:c6:91:a4:05:c8
        addresses:
          - 10.1.100.102/24
        routes:
          - network: 0.0.0.0/0
            gateway: 10.1.100.1
        dhcp: false
        vip:
          ip: 10.1.100.100
  install:
    # Boot disk replaced 2026-09 (Micron 1100 256GB M.2 SATA -> Samsung 990 PRO 1TB
    # NVMe). The old drive hit 100% rated life with ~3.4x write amplification under
    # etcd and started reallocating NAND blocks.
    #
    # Matched on serial like metal-08/metal-09 — unambiguous, stable across Talos
    # versions, and it can never select a USB installer stick left in the front
    # port. This was 'type: nvme' while the replacement drive was still on order
    # and its serial unknown.
    diskSelector:
      serial: 'S7LANS0L541969R'
