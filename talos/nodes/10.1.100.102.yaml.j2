---
machine:
  nodeLabels:
    topology.kubernetes.io/zone: basement
  type: controlplane
  network:
    hostname: metal-02
    interfaces:
      - deviceSelector:
          hardwareAddr: 94:c6:91:a4:05:c8
        addresses:
          - 10.1.100.102/24
        routes:
          - network: 0.0.0.0/0
            gateway: 10.1.100.1
        dhcp: false
        vip:
          ip: 10.1.100.100
  install:
    # Boot disk replaced 2026-09 (Micron 1100 256GB M.2 SATA -> Samsung 990 PRO 1TB
    # NVMe). The old drive hit 100% rated life with ~3.4x write amplification under
    # etcd and started reallocating NAND blocks.
    #
    # Selecting on type rather than model/serial: the NUC7i3BNB has exactly one M.2
    # slot, so 'nvme' can only ever match the new drive, and it stays correct without
    # knowing the serial ahead of time (the old Micron is SATA, so it cannot match
    # even if left installed).
    diskSelector:
      type: nvme
