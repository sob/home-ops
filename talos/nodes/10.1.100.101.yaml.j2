---
machine:
  nodeLabels:
    topology.kubernetes.io/zone: basement
    # Has eno1.99 (LAN-IOT) for Multus macvlan attachments (kube-system/multus).
    # The prefix is the cluster domain, which `op inject` fills in at render time.
    network.{% raw %}{{ op://STONEHEDGES/cluster-secrets/SECRET_INTERNAL_DOMAIN }}{% endraw %}/iot-vlan: "true"
  type: controlplane
  network:
    hostname: metal-01
    interfaces:
      - deviceSelector:
          hardwareAddr: 94:c6:91:a4:3d:d8
          # VLAN links share the parent's MAC; without this they match too.
          physical: true
        addresses:
          - 10.1.100.101/24
        routes:
          - network: 0.0.0.0/0
            gateway: 10.1.100.1
        dhcp: false
        vip:
          ip: 10.1.100.100
        # LAN-IOT, tagged on the switch port (LAN-METAL is native). No address:
        # the node stays off LAN-IOT; only Multus macvlan pods get one.
        vlans:
          - vlanId: 99
            dhcp: false
  install:
    diskSelector:
      model: 'Micron_1100_MTFD*'
