---
machine:
  nodeLabels:
    # Garage rack / failure domain (existing rack = zone "basement")
    topology.kubernetes.io/zone: garage
    # GARAGE-PRO-16 port 1 tags VLAN 99 (LAN-IOT): eno1.99 below carries Multus
    # macvlan attachments (kube-system/multus), which runs only on these nodes.
    network.56kbps.io/iot-vlan: "true"
  type: controlplane
  network:
    hostname: metal-08
    interfaces:
      - deviceSelector:
          hardwareAddr: 94:c6:91:a1:ea:79
        addresses:
          - 10.1.100.108/24
        routes:
          - network: 0.0.0.0/0
            gateway: 10.1.100.1
        dhcp: false
        # Shared control-plane VIP (Talos L2 VIP).
        # Requires this node on the SAME L2 subnet (10.1.100.0/24) as the other CPs.
        vip:
          ip: 10.1.100.100
        # No address: the node stays off LAN-IOT; only macvlan pods get one.
        vlans:
          - vlanId: 99
            dhcp: false
  install:
    # Boot disk is a Samsung 970 EVO 500GB NVMe (was an ADATA SU800 M.2 SATA,
    # which is no longer present). Matched on serial like metal-09 — unambiguous
    # and stable across Talos versions, and it can never select a USB stick left
    # in the front port.
    diskSelector:
      serial: 'S5H7NS1NA05462W'
